{
  "name": "@open-tomato/eslint-plugin",
  "version": "0.2.0",
  "description": "The custom ESLint rules of the open-tomato projects: no-unsafe-unicode, cva-only-classname, and the atomic-layer rules layer-imports, no-restyle-from-above and shared-variants.",
  "license": "Apache-2.0",
  "author": "Marcos Tomatti",
  "openTomato": {
    "team": "@open-tomato/maintainers"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/packages.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/open-tomato/packages/tree/main/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/open-tomato/packages/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "unicode",
    "trojan-source",
    "cva",
    "atomic-design"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./rules/no-unsafe-unicode": {
      "types": "./rules/no-unsafe-unicode.d.mts",
      "default": "./rules/no-unsafe-unicode.mjs"
    },
    "./rules/cva-only-classname": {
      "types": "./rules/cva-only-classname.d.mts",
      "default": "./rules/cva-only-classname.mjs"
    },
    "./rules/layer-imports": {
      "types": "./rules/layer-imports.d.mts",
      "default": "./rules/layer-imports.mjs"
    },
    "./rules/no-restyle-from-above": {
      "types": "./rules/no-restyle-from-above.d.mts",
      "default": "./rules/no-restyle-from-above.mjs"
    },
    "./rules/shared-variants": {
      "types": "./rules/shared-variants.d.mts",
      "default": "./rules/shared-variants.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "rules"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "eslint": "^9.39.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
