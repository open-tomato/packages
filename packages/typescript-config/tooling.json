{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "open-tomato mixin: code that never ships, such as stories, visual suites and scripts",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "isolatedDeclarations": false
  }
}
