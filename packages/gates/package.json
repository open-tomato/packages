{
  "name": "@open-tomato/gates",
  "version": "0.1.1",
  "description": "Repository gates of the open-tomato projects: a control-byte gate and a privacy gate, run in CI and as pre-commit hooks.",
  "license": "Apache-2.0",
  "author": "Marcos Tomatti",
  "openTomato": {
    "team": "@open-tomato/maintainers"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/packages.git",
    "directory": "packages/gates"
  },
  "homepage": "https://github.com/open-tomato/packages/tree/main/packages/gates#readme",
  "bugs": {
    "url": "https://github.com/open-tomato/packages/issues"
  },
  "keywords": [
    "gate",
    "privacy",
    "pre-commit",
    "trojan-source",
    "control-characters"
  ],
  "type": "module",
  "bin": {
    "ot-control-byte-gate": "./src/control-byte-gate.ts",
    "ot-privacy-gate": "./src/privacy-gate.ts"
  },
  "exports": {
    "./control-bytes": "./src/control-byte-gate.ts",
    "./privacy": "./src/privacy-gate.ts",
    "./privacy/rules": "./src/privacy-rules.ts",
    "./privacy/config": "./src/privacy-config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@open-tomato/eslint-config": "workspace:^",
    "@open-tomato/eslint-plugin": "workspace:^",
    "@open-tomato/typescript-config": "workspace:^",
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
