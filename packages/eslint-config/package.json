{
  "name": "@open-tomato/eslint-config",
  "version": "0.1.1",
  "description": "The shared flat ESLint config of the open-tomato projects: a base for JavaScript, TypeScript, Markdown and JSON, plus react, vite, cva, atomic, type-aware and markdown-fences flavors.",
  "license": "Apache-2.0",
  "author": "Marcos Tomatti",
  "openTomato": {
    "team": "@open-tomato/maintainers"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/packages.git",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/open-tomato/packages/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/open-tomato/packages/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript",
    "react",
    "atomic-design"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./base.d.mts",
      "default": "./base.mjs"
    },
    "./base": {
      "types": "./base.d.mts",
      "default": "./base.mjs"
    },
    "./react": {
      "types": "./react.d.mts",
      "default": "./react.mjs"
    },
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./cva": {
      "types": "./cva.d.mts",
      "default": "./cva.mjs"
    },
    "./atomic": {
      "types": "./atomic.d.mts",
      "default": "./atomic.mjs"
    },
    "./type-aware": {
      "types": "./type-aware.d.mts",
      "default": "./type-aware.mjs"
    },
    "./markdown-fences": {
      "types": "./markdown-fences.d.mts",
      "default": "./markdown-fences.mjs"
    },
    "./files": {
      "types": "./files.d.mts",
      "default": "./files.mjs"
    },
    "./shared-rules": {
      "types": "./shared-rules.d.mts",
      "default": "./shared-rules.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "base.mjs",
    "base.d.mts",
    "react.mjs",
    "react.d.mts",
    "vite.mjs",
    "vite.d.mts",
    "cva.mjs",
    "cva.d.mts",
    "atomic.mjs",
    "atomic.d.mts",
    "type-aware.mjs",
    "type-aware.d.mts",
    "markdown-fences.mjs",
    "markdown-fences.d.mts",
    "files.mjs",
    "files.d.mts",
    "shared-rules.mjs",
    "shared-rules.d.mts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "typescript": ">=5.8.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/markdown": "^8.0.3",
    "@open-tomato/eslint-plugin": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsonc-eslint-parser": "^3.1.0",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
